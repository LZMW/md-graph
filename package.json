  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  }
